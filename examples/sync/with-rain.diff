+import { MikroOrmModule } from '@mikro-orm/nestjs';
+import { Module } from '@nestjs/common';
+import { ConfigModule, ConfigType } from '@nestjs/config';
+import { Octokit } from '@octokit/rest';
+
+import { InternalGithubController } from './controllers/internal.github.controller';
+import { GithubRepositoryService } from './services/github-repository.service';
+
+import { GithubLabel } from './entities/github-label.entity';
+import { GithubRepository } from './entities/github-repository.entity';
+
+import InternalConfig from '../common/internal.config';
+import GithubConfig from './github.config';
+
+@Module({
+  imports: [
+    ConfigModule.forFeature(GithubConfig),
+    ConfigModule.forFeature(InternalConfig),
+    MikroOrmModule.forFeature([GithubRepository, GithubLabel]),
+  ],
+  controllers: [InternalGithubController],
+  providers: [
+    {
+      provide: Octokit,
+      inject: [GithubConfig.KEY],
+      useFactory: (config: ConfigType<typeof GithubConfig>) => new Octokit({ auth: config.token }),
+    },
+
+    GithubRepositoryService,
+  ],
+  exports: [GithubRepositoryService],
+})
+export class GithubModule {}
diff --git a/src/github/services/github-repository.service.ts b/src/github/services/github-repository.service.ts
--- a/src/github/services/github-repository.service.ts
+++ b/src/github/services/github-repository.service.ts
@@ -0,0 +1,115 @@
+import { EntityManager } from '@mikro-orm/postgresql';
+import { Inject, Injectable } from '@nestjs/common';
+import { ConfigType } from '@nestjs/config';
+import { Octokit } from '@octokit/rest';
+
+import { GithubLabel, GithubLabelPayload } from '../entities/github-label.entity';
+import { GithubRepository, GithubRepositoryPayload } from '../entities/github-repository.entity';
+
+import GithubConfig from '../github.config';
+
+const PAGE_SIZE = 100;
+const SYNC_LOCK_KEY = 'github:repository-sync';
+
+@Injectable()
+export class GithubRepositoryService {
+  constructor(
+    private readonly entityManager: EntityManager,
+    private readonly octokit: Octokit,
+    @Inject(GithubConfig.KEY) private readonly config: ConfigType<typeof GithubConfig>,
+  ) {}
+
+  async findLabel(
+    repositoryOpts: { name: string },
+    labelOpts: { name: string },
+    opts: { em?: EntityManager } = {},
+  ): Promise<GithubLabel | null> {
+    const em = opts.em ?? this.entityManager;
+
+    return await em.findOne(GithubLabel, {
+      name: labelOpts.name,
+      deletedAt: null,
+      repository: { name: repositoryOpts.name, deletedAt: null },
+    });
+  }
+
+  async syncRepositories(): Promise<{ repositories: number; labels: number }> {
+    // NOTE: Read GitHub before opening the transaction so no DB connection idles through API calls.
+    const remote = await this.fetchRemote();
+
+    await this.entityManager.transactional(async (em) => {
+      // WARNING: Serializes overlapping syncs; without it both insert the same remoteId and one fails.
+      await em.execute('SELECT pg_advisory_xact_lock(hashtext(?))', [SYNC_LOCK_KEY]);
+
+      // NOTE: Overlapping syncs apply last-writer-wins; the next run corrects a slightly older snapshot.
+      const localRepositories = await em.find(GithubRepository, {});
+      const localLabels = await em.find(GithubLabel, {});
+      const repositoriesByRemoteId = new Map(localRepositories.map((repository) => [repository.remoteId, repository]));
+      const labelsByRemoteId = new Map(localLabels.map((label) => [label.remoteId, label]));
+      const seenRepositoryRemoteIds = new Set<string>();
+      const seenLabelRemoteIds = new Set<string>();
+
+      for (const { remoteRepository, remoteLabels } of remote) {
+        const repositoryRemoteId = String(remoteRepository.id);
+        const repository = repositoriesByRemoteId.get(repositoryRemoteId) ?? new GithubRepository();
+        repository.remoteId = repositoryRemoteId;
+        repository.name = remoteRepository.name;
+        repository.raw = remoteRepository;
+        repository.deletedAt = null;
+        em.persist(repository);
+        seenRepositoryRemoteIds.add(repositoryRemoteId);
+
+        for (const remoteLabel of remoteLabels) {
+          const labelRemoteId = String(remoteLabel.id);
+          const label = labelsByRemoteId.get(labelRemoteId) ?? new GithubLabel();
+          label.remoteId = labelRemoteId;
+          label.repository = repository;
+          label.name = remoteLabel.name;
+          label.raw = remoteLabel;
+          label.deletedAt = null;
+          em.persist(label);
+          seenLabelRemoteIds.add(labelRemoteId);
+        }
+      }
+
+      // Rows missing from GitHub stay for history but drop out of lookups.
+      const deletedAt = new Date();
+      for (const repository of localRepositories) {
+        if (seenRepositoryRemoteIds.has(repository.remoteId) || repository.deletedAt !== null) continue;
+        repository.deletedAt = deletedAt;
+      }
+      for (const label of localLabels) {
+        if (seenLabelRemoteIds.has(label.remoteId) || label.deletedAt !== null) continue;
+        label.deletedAt = deletedAt;
+      }
+
+      await em.flush();
+    });
+
+    return {
+      repositories: remote.length,
+      labels: remote.reduce((total, { remoteLabels }) => total + remoteLabels.length, 0),
+    };
+  }
+
+  private async fetchRemote(): Promise<
+    { remoteRepository: GithubRepositoryPayload; remoteLabels: GithubLabelPayload[] }[]
+  > {
+    const remoteRepositories = await this.octokit.paginate(this.octokit.rest.repos.listForOrg, {
+      org: this.config.org,
+      per_page: PAGE_SIZE,
+    });
+
+    const remote: { remoteRepository: GithubRepositoryPayload; remoteLabels: GithubLabelPayload[] }[] = [];
+    for (const remoteRepository of remoteRepositories) {
+      const remoteLabels = await this.octokit.paginate(this.octokit.rest.issues.listLabelsForRepo, {
+        owner: this.config.org,
+        repo: remoteRepository.name,
+        per_page: PAGE_SIZE,
+      });
+      remote.push({ remoteRepository, remoteLabels });
+    }
+
+    return remote;
+  }
+}
