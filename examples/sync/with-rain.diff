+import { Entity, PrimaryKey, Property } from '@mikro-orm/core';
+import type { RestEndpointMethodTypes } from '@octokit/rest';
+
+export type GithubRepositoryPayload = RestEndpointMethodTypes['repos']['listForOrg']['response']['data'][number];
+
+@Entity()
+export class GithubRepository {
+  @PrimaryKey({ type: 'bigint' })
+  id!: string;
+
+  @Property({ type: 'uuid', defaultRaw: 'gen_random_uuid()', unique: true })
+  uuid!: string;
+
+  @Property({ type: 'text', unique: true, comment: 'GitHub Repository ID' })
+  remoteId!: string;
+
+  // NOTE: Not unique; two repositories can swap names between syncs.
+  @Property({ type: 'text', index: true })
+  name!: string;
+
+  @Property({ type: 'json', nullable: true })
+  raw: GithubRepositoryPayload | null = null;
+
+  // Set by the sync when the repository leaves the org listing; label lookups skip it.
+  @Property({ type: 'datetime', nullable: true })
+  deletedAt: Date | null = null;
+
+  @Property({ type: 'datetime', defaultRaw: 'NOW()' })
+  createdAt!: Date;
+
+  @Property({ type: 'datetime', defaultRaw: 'NOW()', onUpdate: () => new Date() })
+  updatedAt!: Date;
+}
