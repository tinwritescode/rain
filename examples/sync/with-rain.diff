@@ -0,0 +1,39 @@
+import { Entity, Index, ManyToOne, PrimaryKey, Property } from '@mikro-orm/core';
+import type { RestEndpointMethodTypes } from '@octokit/rest';
+
+import { GithubRepository } from './github-repository.entity';
+
+export type GithubLabelPayload = RestEndpointMethodTypes['issues']['listLabelsForRepo']['response']['data'][number];
+
+@Entity()
+// NOTE: Not unique; a rename and a new label can swap names between syncs.
+@Index({ properties: ['repository', 'name'] })
+export class GithubLabel {
+  @PrimaryKey({ type: 'bigint' })
+  id!: string;
+
+  @Property({ type: 'uuid', defaultRaw: 'gen_random_uuid()', unique: true })
+  uuid!: string;
+
+  @Property({ type: 'text', unique: true, comment: 'GitHub Label ID' })
+  remoteId!: string;
+
+  @ManyToOne(() => GithubRepository)
+  repository!: GithubRepository;
+
+  @Property({ type: 'text' })
+  name!: string;
+
+  @Property({ type: 'json', nullable: true })
+  raw: GithubLabelPayload | null = null;
+
+  // Set by the sync when the label leaves its repository; lookups skip it.
+  @Property({ type: 'datetime', nullable: true })
+  deletedAt: Date | null = null;
+
+  @Property({ type: 'datetime', defaultRaw: 'NOW()' })
+  createdAt!: Date;
+
+  @Property({ type: 'datetime', defaultRaw: 'NOW()', onUpdate: () => new Date() })
+  updatedAt!: Date;
+}
