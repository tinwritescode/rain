@@ -0,0 +1,19 @@
+import { Controller, HttpCode, HttpStatus, Post, UseGuards } from '@nestjs/common';
+
+import { InternalApiKeyGuard } from '../../common/guards/internal-api-key.guard';
+import { GithubRepositoryService } from '../services/github-repository.service';
+
+import { InternalGithubRepositorySyncResponseBodyDto } from '../dtos/internal-github-repository-sync-request.dto';
+
+@Controller('internal/github')
+@UseGuards(InternalApiKeyGuard)
+export class InternalGithubController {
+  constructor(private readonly githubRepositoryService: GithubRepositoryService) {}
+
+  // TODO: Also run nightly from a worker cron once a scheduler is in the stack.
+  @Post('repository/sync')
+  @HttpCode(HttpStatus.OK)
+  async syncRepositories(): Promise<InternalGithubRepositorySyncResponseBodyDto> {
+    return await this.githubRepositoryService.syncRepositories();
+  }
+}
