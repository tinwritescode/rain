+import { MikroOrmModule } from '@mikro-orm/nestjs';
+import { Module } from '@nestjs/common';
+import { GithubLabel } from './entities/github-label.entity';
+import { GithubRepository } from './entities/github-repository.entity';
+import { GithubSyncService } from './github-sync.service';
+
+@Module({
+  imports: [MikroOrmModule.forFeature([GithubRepository, GithubLabel])],
+  providers: [GithubSyncService],
+  exports: [GithubSyncService],
+})
+export class GithubModule {}
diff --git a/src/github/sync-github.ts b/src/github/sync-github.ts
--- a/src/github/sync-github.ts
+++ b/src/github/sync-github.ts
@@ -0,0 +1,19 @@
+// Runs the GitHub repository/label sync once and exits.
+// Needs GITHUB_TOKEN and GITHUB_ORG set, plus the usual database config.
+import { NestFactory } from '@nestjs/core';
+import { AppModule } from '../app.module';
+import { GithubSyncService } from './github-sync.service';
+
+async function main() {
+  const app = await NestFactory.createApplicationContext(AppModule);
+  try {
+    await app.get(GithubSyncService).sync();
+  } finally {
+    await app.close();
+  }
+}
+
+main().catch((error) => {
+  console.error(error);
+  process.exitCode = 1;
+});
