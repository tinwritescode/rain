diff --git a/src/webhook/services/webhook.service.ts b/src/webhook/services/webhook.service.ts
--- a/src/webhook/services/webhook.service.ts
+++ b/src/webhook/services/webhook.service.ts
@@ -0,0 +1,159 @@
+import { createHmac, timingSafeEqual } from 'node:crypto';
+import { IncomingHttpHeaders } from 'node:http';
+
+import { EntityManager } from '@mikro-orm/postgresql';
+import { BadRequestException, Inject, Injectable, Logger, UnauthorizedException } from '@nestjs/common';
+import { ConfigType } from '@nestjs/config';
+
+import { TaskService } from '../../tasks/services/task.service';
+
+import { WebhookDelivery } from '../entities/webhook-delivery.entity';
+
+import { WebhookProvider } from '../enums/webhook-provider.enum';
+
+import GithubConfig from '../github.config';
+
+// Only the fields we read. Reference: https://docs.github.com/en/webhooks/webhook-events-and-payloads#pull_request
+type GithubPullRequestEvent = {
+  action: string;
+  pull_request: { number: number; merged: boolean };
+  repository: { full_name: string };
+};
+
+@Injectable()
+export class WebhookService {
+  private readonly logger = new Logger(WebhookService.name);
+
+  constructor(
+    private readonly entityManager: EntityManager,
+    private readonly taskService: TaskService,
+    @Inject(GithubConfig.KEY) private readonly githubConfig: ConfigType<typeof GithubConfig>,
+  ) {}
+
+  async processEvent(provider: WebhookProvider, rawBody: Buffer, headers: IncomingHttpHeaders): Promise<void> {
+    switch (provider) {
+      case WebhookProvider.GITHUB:
+        return await this.processGithubEvent(rawBody, headers);
+      default:
+        throw new BadRequestException('Unsupported Provider');
+    }
+  }
+
+  // Re-dispatches a stored delivery, e.g. from the REPL after a bug fix.
+  async replayEvent(id: number): Promise<void> {
+    const delivery = await this.entityManager.findOneOrFail(WebhookDelivery, { id });
+    await this.dispatch(delivery);
+  }
+
+  private async processGithubEvent(rawBody: Buffer, headers: IncomingHttpHeaders): Promise<void> {
+    const deliveryId = this.verifyGithubSignature(rawBody, headers);
+    const event = headers['x-github-event'];
+    if (typeof event !== 'string') throw new BadRequestException('Missing Event Header');
+
+    let delivery = await this.entityManager.findOne(WebhookDelivery, {
+      provider: WebhookProvider.GITHUB,
+      remoteId: deliveryId,
+    });
+    if (delivery === null) {
+      delivery = new WebhookDelivery();
+      delivery.provider = WebhookProvider.GITHUB;
+      delivery.remoteId = deliveryId;
+      delivery.event = event;
+      delivery.payload = this.parseJson(rawBody);
+      await this.entityManager.persist(delivery).flush();
+    }
+
+    // NOTE: A redelivery of a stored event dispatches again; handlers are idempotent.
+    await this.dispatch(delivery);
+  }
+
+  private async dispatch(delivery: WebhookDelivery): Promise<void> {
+    let relatedObject: string | null;
+    switch (delivery.provider) {
+      case WebhookProvider.GITHUB:
+        relatedObject = await this.dispatchGithub(delivery);
+        break;
+      default:
+        throw new BadRequestException('Unsupported Provider');
+    }
+
+    if (relatedObject === null) return;
+    delivery.relatedObject = relatedObject;
+    await this.entityManager.flush();
+  }
+
+  private async dispatchGithub(delivery: WebhookDelivery): Promise<string | null> {
+    switch (delivery.event) {
+      case 'pull_request':
+        return await this.handleGithubPullRequest(delivery.payload as GithubPullRequestEvent);
+      // NOTE: Not needed yet
+      case 'ping':
+      case 'push':
+      case 'pull_request_review':
+      case 'pull_request_review_comment':
+      case 'issues':
+      case 'issue_comment':
+      default:
+        this.logger.log(`Ignored GitHub event ${delivery.event} (delivery ${delivery.remoteId})`);
+        return null;
+    }
+  }
+
+  private async handleGithubPullRequest(payload: GithubPullRequestEvent): Promise<string | null> {
+    switch (payload.action) {
+      case 'closed': {
+        // Closed without merging leaves the task open.
+        if (payload.pull_request.merged !== true) return null;
+
+        // NOTE: Merging is final on GitHub, so event order cannot move a task backwards; no stale-event check needed.
+        // WARNING: Must match the "owner/repo#number" format stored in Task.githubPullRequest, including case.
+        const pullRequest = `${payload.repository.full_name}#${payload.pull_request.number}`;
+        await this.taskService.completeByPullRequest({ pullRequest });
+        return pullRequest;
+      }
+      // NOTE: Not needed yet
+      case 'opened':
+      case 'reopened':
+      case 'edited':
+      case 'synchronize':
+      case 'assigned':
+      case 'unassigned':
+      case 'labeled':
+      case 'unlabeled':
+      case 'ready_for_review':
+      case 'converted_to_draft':
+      case 'review_requested':
+      case 'review_request_removed':
+      default:
+        this.logger.log(`Ignored GitHub pull_request action ${payload.action}`);
+        return null;
+    }
+  }
+
+  private verifyGithubSignature(rawBody: Buffer, headers: IncomingHttpHeaders): string {
+    const deliveryId = headers['x-github-delivery'];
+    const signature = headers['x-hub-signature-256'];
+    if (typeof deliveryId !== 'string' || typeof signature !== 'string') {
+      throw new UnauthorizedException('Invalid Signature');
+    }
+
+    const digest = createHmac('sha256', this.githubConfig.webhookSecret).update(rawBody).digest('hex');
+    const expected = Buffer.from(`sha256=${digest}`);
+    const given = Buffer.from(signature);
+
+    // NOTE: Compare equal-length buffers either way so response time does not reveal the signature length.
+    const matches = timingSafeEqual(given.length === expected.length ? given : expected, expected);
+    if (given.length !== expected.length || !matches) throw new UnauthorizedException('Invalid Signature');
+
+    return deliveryId;
+  }
+
+  private parseJson(rawBody: Buffer): any {
+    try {
+      return JSON.parse(rawBody.toString('utf8'));
+    } catch {
+      // NOTE: The webhook must use content type application/json; a form-encoded body lands here.
+      throw new BadRequestException('Invalid Payload');
+    }
+  }
+}
