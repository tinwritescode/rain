diff --git a/src/webhook/entities/webhook-delivery.entity.ts b/src/webhook/entities/webhook-delivery.entity.ts
--- a/src/webhook/entities/webhook-delivery.entity.ts
+++ b/src/webhook/entities/webhook-delivery.entity.ts
@@ -0,0 +1,34 @@
+import { Entity, Enum, PrimaryKey, Property, Unique } from '@mikro-orm/core';
+
+import { WebhookProvider } from '../enums/webhook-provider.enum';
+
+@Entity()
+@Unique({ properties: ['provider', 'remoteId'] })
+export class WebhookDelivery {
+  @PrimaryKey()
+  id!: number;
+
+  @Enum(() => WebhookProvider)
+  provider!: WebhookProvider;
+
+  @Property({ comment: 'Provider delivery ID (X-GitHub-Delivery for GitHub)' })
+  remoteId!: string;
+
+  // Provider event name, e.g. "pull_request"
+  @Property()
+  event!: string;
+
+  // Raw provider payload, kept so replayEvent can re-dispatch it.
+  @Property({ type: 'json' })
+  payload!: any;
+
+  // Object the event acted on, e.g. the pull request key "owner/repo#123"
+  @Property({ nullable: true })
+  relatedObject?: string;
+
+  @Property({ defaultRaw: 'NOW()' })
+  createdAt!: Date;
+
+  @Property({ defaultRaw: 'NOW()', onUpdate: () => new Date() })
+  updatedAt!: Date;
+}
