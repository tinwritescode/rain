diff --git a/src/webhook/controllers/webhook.controller.ts b/src/webhook/controllers/webhook.controller.ts
--- a/src/webhook/controllers/webhook.controller.ts
+++ b/src/webhook/controllers/webhook.controller.ts
@@ -0,0 +1,35 @@
+import { IncomingHttpHeaders, IncomingMessage } from 'node:http';
+
+import {
+  BadRequestException,
+  Controller,
+  Headers,
+  HttpCode,
+  HttpStatus,
+  Param,
+  Post,
+  RawBodyRequest,
+  Req,
+} from '@nestjs/common';
+
+import { WebhookService } from '../services/webhook.service';
+
+import { WebhookReceiveRequestParamsDto } from '../dtos/webhook-receive-request.dto';
+
+@Controller('webhook')
+export class WebhookController {
+  constructor(private readonly webhookService: WebhookService) {}
+
+  // Called by GitHub. Public on purpose: the provider signature authenticates each request.
+  @Post(':provider')
+  @HttpCode(HttpStatus.OK)
+  async receive(
+    @Param() params: WebhookReceiveRequestParamsDto,
+    @Req() req: RawBodyRequest<IncomingMessage>,
+    @Headers() headers: IncomingHttpHeaders,
+  ): Promise<void> {
+    if (req.rawBody === undefined) throw new BadRequestException('Missing Body');
+
+    await this.webhookService.processEvent(params.provider, req.rawBody, headers);
+  }
+}
