--- a/src/config/env.validation.ts
+++ b/src/config/env.validation.ts
@@ -0,0 +1,26 @@
+import { plainToInstance } from 'class-transformer';
+import { IsInt, IsNotEmpty, IsOptional, IsString, validateSync } from 'class-validator';
+
+class EnvironmentVariables {
+  @IsOptional()
+  @IsInt()
+  PORT?: number;
+
+  @IsNotEmpty()
+  @IsString()
+  GITHUB_WEBHOOK_SECRET!: string;
+}
+
+// Passed to ConfigModule.forRoot so boot fails listing every invalid variable at once.
+export function validate(config: Record<string, unknown>): EnvironmentVariables {
+  const env = plainToInstance(EnvironmentVariables, config, { enableImplicitConversion: true });
+  const errors = validateSync(env, {
+    skipMissingProperties: false,
+    skipNullProperties: false,
+    skipUndefinedProperties: false,
+  });
+  if (errors.length === 0) return env;
+
+  const messages = errors.flatMap((error) => Object.values(error.constraints ?? {}));
+  throw new Error(`Invalid environment:\n${messages.join('\n')}`);
+}
diff --git a/src/main.ts b/src/main.ts
