+++ b/src/main.ts
@@ -0,0 +1,15 @@
+import { ValidationPipe } from '@nestjs/common';
+import { NestFactory } from '@nestjs/core';
+
+import { AppModule } from './app.module';
+
+const DEFAULT_PORT = 3000;
+
+async function bootstrap(): Promise<void> {
+  // WARNING: rawBody must stay on; webhook signatures are computed over the exact request bytes.
+  const app = await NestFactory.create(AppModule, { rawBody: true });
+  app.useGlobalPipes(new ValidationPipe({ whitelist: true, transform: true }));
+  await app.listen(process.env.PORT ?? DEFAULT_PORT);
+}
+
+void bootstrap();
diff --git a/src/tasks/services/task.service.ts b/src/tasks/services/task.service.ts
--- a/src/tasks/services/task.service.ts
+++ b/src/tasks/services/task.service.ts
@@ -0,0 +1,39 @@
+import { EntityManager, LockMode } from '@mikro-orm/postgresql';
+import { Injectable } from '@nestjs/common';
+
+import { Member } from '../entities/member.entity';
+import { Task } from '../entities/task.entity';
+
+import { TaskStatus } from '../enums/task-status.enum';
+
+@Injectable()
+export class TaskService {
+  constructor(private readonly entityManager: EntityManager) {}
+
+  // Called by the GitHub webhook when a linked pull request is merged.
+  async completeByPullRequest(pullRequestOpts: { pullRequest: string }): Promise<void> {
+    await this.entityManager.transactional(async (em) => {
+      // NOTE: FOR UPDATE re-evaluates the status filter after waiting, so a concurrent delivery that already completed a task skips it.
+      const tasks = await em.find(
+        Task,
+        { githubPullRequest: pullRequestOpts.pullRequest, status: TaskStatus.OPEN },
+        { lockMode: LockMode.PESSIMISTIC_WRITE, orderBy: { id: 'asc' } },
+      );
+
+      for (const task of tasks) {
+        task.status = TaskStatus.DONE;
+        if (task.assignee === undefined || task.assignee === null) continue;
+
+        // WARNING: Lock and reload the member before touching the counter, or parallel completions lose increments.
+        const member = await em.findOneOrFail(
+          Member,
+          { id: task.assignee.id },
+          { lockMode: LockMode.PESSIMISTIC_WRITE, refresh: true },
+        );
+        member.completedTasks += 1;
+      }
+
+      await em.flush();
+    });
+  }
+}
