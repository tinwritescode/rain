diff --git a/src/tasks/tasks.service.ts b/src/tasks/tasks.service.ts
--- a/src/tasks/tasks.service.ts
+++ b/src/tasks/tasks.service.ts
@@ -0,0 +1,33 @@
+import { EntityManager, raw } from '@mikro-orm/postgresql';
+import { Injectable } from '@nestjs/common';
+import { Member } from './entities/member.entity';
+import { Task } from './entities/task.entity';
+import { TaskStatus } from './enums/task-status.enum';
+
+@Injectable()
+export class TasksService {
+  constructor(private readonly em: EntityManager) {}
+
+  /**
+   * Marks every open task linked to the pull request as done and credits its assignee.
+   * Safe to call more than once for the same pull request (GitHub redelivers webhooks).
+   */
+  async completeTasksForMergedPullRequest(pullRequestRef: string): Promise<void> {
+    await this.em.transactional(async (em) => {
+      const tasks = await em.find(Task, { githubPullRequest: pullRequestRef, status: TaskStatus.OPEN });
+
+      for (const task of tasks) {
+        // Conditional update so a concurrent delivery cannot complete the same task twice.
+        const updated = await em.nativeUpdate(
+          Task,
+          { id: task.id, status: TaskStatus.OPEN },
+          { status: TaskStatus.DONE },
+        );
+        if (updated === 1 && task.assignee) {
+          // Increment in SQL to avoid lost updates when several tasks finish at once.
+          await em.nativeUpdate(Member, { id: task.assignee.id }, { completedTasks: raw('completed_tasks + 1') });
+        }
+      }
+    });
+  }
+}
