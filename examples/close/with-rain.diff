+  status!: TaskStatus;
+}
diff --git a/src/tasks/services/task.service.ts b/src/tasks/services/task.service.ts
--- a/src/tasks/services/task.service.ts
+++ b/src/tasks/services/task.service.ts
@@ -0,0 +1,44 @@
+import { EntityManager, LockMode } from '@mikro-orm/postgresql';
+import { BadRequestException, Injectable, NotFoundException } from '@nestjs/common';
+
+import { Member } from '../entities/member.entity';
+import { Task } from '../entities/task.entity';
+
+import { TaskStatus } from '../enums/task-status.enum';
+
+@Injectable()
+export class TaskService {
+  constructor(private readonly entityManager: EntityManager) {}
+
+  async close(
+    taskOpts: { id: number },
+    memberOpts: { externalId: string },
+  ): Promise<{ id: number; status: TaskStatus }> {
+    return await this.entityManager.transactional(async (em) => {
+      const member = await this.lockMember(memberOpts, em);
+
+      // NOTE: Read the task after the member lock so a concurrent close sees the committed status.
+      const task = await em.findOne(Task, { id: taskOpts.id, assignee: member });
+      if (task === null) throw new NotFoundException('Task Not Found');
+
+      // NOTE: Already closed is success, so the HR service can retry safely.
+      if (task.status === TaskStatus.CLOSED) return { id: task.id, status: task.status };
+      if (task.status !== TaskStatus.OPEN) throw new BadRequestException(`Task Not Open: ${task.status}`);
+
+      task.status = TaskStatus.CLOSED;
+      await em.flush();
+
+      return { id: task.id, status: task.status };
+    });
+  }
+
+  private async lockMember(memberOpts: { externalId: string }, em: EntityManager): Promise<Member> {
+    const member = await em.findOne(
+      Member,
+      { externalId: memberOpts.externalId },
+      { lockMode: LockMode.PESSIMISTIC_WRITE },
+    );
+    if (member === null) throw new NotFoundException('Member Not Found');
+    return member;
+  }
+}
