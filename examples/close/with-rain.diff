@@ -0,0 +1,26 @@
+import { Body, Controller, HttpCode, HttpStatus, Param, Post, UseGuards } from '@nestjs/common';
+
+import { InternalApiKeyGuard } from '../../auth/guards/internal-api-key.guard';
+import { TaskService } from '../services/task.service';
+
+import {
+  InternalTaskCloseRequestBodyDto,
+  InternalTaskCloseRequestParamsDto,
+  InternalTaskCloseResponseBodyDto,
+} from '../dtos/internal-task-close-request.dto';
+
+// Called by the HR service to close tasks of members who leave the company.
+@Controller('internal/task')
+@UseGuards(InternalApiKeyGuard)
+export class InternalTaskController {
+  constructor(private readonly taskService: TaskService) {}
+
+  @Post(':task/close')
+  @HttpCode(HttpStatus.OK)
+  async close(
+    @Param() params: InternalTaskCloseRequestParamsDto,
+    @Body() body: InternalTaskCloseRequestBodyDto,
+  ): Promise<InternalTaskCloseResponseBodyDto> {
+    return await this.taskService.close({ id: params.task }, { externalId: body.memberId });
+  }
+}
