diff --git a/src/auth/guards/internal-api-key.guard.ts b/src/auth/guards/internal-api-key.guard.ts
--- a/src/auth/guards/internal-api-key.guard.ts
+++ b/src/auth/guards/internal-api-key.guard.ts
@@ -0,0 +1,27 @@
+import { timingSafeEqual } from 'node:crypto';
+import type { IncomingMessage } from 'node:http';
+
+import { CanActivate, ExecutionContext, ForbiddenException, Inject, Injectable } from '@nestjs/common';
+import { ConfigType } from '@nestjs/config';
+
+import AuthConfig from '../auth.config';
+
+@Injectable()
+export class InternalApiKeyGuard implements CanActivate {
+  private readonly key: Buffer;
+
+  constructor(@Inject(AuthConfig.KEY) config: ConfigType<typeof AuthConfig>) {
+    this.key = Buffer.from(config.internalApiKey);
+  }
+
+  canActivate(context: ExecutionContext): boolean {
+    const header = context.switchToHttp().getRequest<IncomingMessage>().headers['x-internal-api-key'];
+    const given = Buffer.from(typeof header === 'string' ? header : '');
+
+    // NOTE: Compare equal-length buffers either way so response time does not reveal the key length.
+    const matches = timingSafeEqual(given.length === this.key.length ? given : this.key, this.key);
+    if (given.length !== this.key.length || !matches) throw new ForbiddenException();
+
+    return true;
+  }
+}
diff --git a/src/config/env.validation.ts b/src/config/env.validation.ts
--- a/src/config/env.validation.ts
+++ b/src/config/env.validation.ts
@@ -0,0 +1,27 @@
+import { plainToInstance } from 'class-transformer';
+import { IsNotEmpty, IsString, MinLength, validateSync } from 'class-validator';
+
+const MIN_INTERNAL_API_KEY_LENGTH = 32;
+
+export class EnvironmentVariables {
+  // Shared secret the HR service sends in the x-internal-api-key header.
+  @IsNotEmpty()
+  @IsString()
+  @MinLength(MIN_INTERNAL_API_KEY_LENGTH)
+  INTERNAL_API_KEY!: string;
+}
+
+export function validate(config: Record<string, unknown>): EnvironmentVariables {
+  const env = plainToInstance(EnvironmentVariables, config);
+  const errors = validateSync(env, {
+    skipMissingProperties: false,
+    skipNullProperties: false,
+    skipUndefinedProperties: false,
+  });
+  if (errors.length > 0) {
+    const violations = errors.flatMap((error) => Object.values(error.constraints ?? {}));
+    throw new Error(`Invalid Environment: ${violations.join('; ')}`);
+  }
+
+  return env;
+}
diff --git a/src/tasks/controllers/internal.task.controller.ts b/src/tasks/controllers/internal.task.controller.ts
--- a/src/tasks/controllers/internal.task.controller.ts
